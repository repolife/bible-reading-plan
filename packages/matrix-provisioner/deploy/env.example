# /etc/matrix-provisioner/env  (chmod 600, owned by root)
# Shared with Netlify as MATRIX_PROVISIONER_SECRET. Generate: openssl rand -hex 32
PROVISIONER_HMAC_SECRET=

# From homeserver.yaml `registration_shared_secret`.
SYNAPSE_REGISTRATION_SHARED_SECRET=

# Access token of the @provisioner bot (a Synapse server admin). See README.
SYNAPSE_ADMIN_TOKEN=

SYNAPSE_URL=http://127.0.0.1:8008
MATRIX_SERVER_NAME=ozark-fellowship.netlify.app
BIND_HOST=127.0.0.1
PORT=8787
STATE_FILE=/var/lib/matrix-provisioner/state.json

# Room ID (!...) of the "Calendar alerts" room. The @provisioner bot must be a
# member allowed to post. POST /v1/announcements can only post here.
ANNOUNCEMENTS_ROOM_ID=
